# Copy to .env and fill in. Never commit .env.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/metrosync
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Admin seeded by seed.js
ADMIN_EMAIL=admin@metrosync.io
ADMIN_PASSWORD=admin1234
# Comma-separated allowed origins for CORS/Socket.io (frontend URL). * for any.
CLIENT_ORIGIN=*
